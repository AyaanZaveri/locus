{
  "name": "locus",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:company-schema": "tsx scripts/generate-company-profile-schema.ts",
    "validate:companies": "tsx scripts/validate-company-profiles.ts",
    "validate:job-markdown": "tsx scripts/validate-job-markdown.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed-jobs-database.ts",
    "db:import": "tsx --env-file=.env.local scripts/seed-jobs-database.ts",
    "db:inspect-jobs": "tsx --env-file=.env.local scripts/inspect-job-descriptions.ts",
    "db:sync-ashby": "tsx scripts/sync-ashby-jobs.ts",
    "db:sync-greenhouse": "tsx scripts/sync-greenhouse-jobs.ts",
    "db:normalize-jobs": "tsx scripts/normalize-job-markdown.ts",
    "db:repair-job-markdown": "tsx --env-file=.env.local scripts/repair-job-markdown.ts",
    "db:normalize-job-locations": "tsx --env-file=.env.local scripts/repair-job-locations.ts",
    "db:migrate-locations": "tsx --env-file=.env.local scripts/migrate-location-catalog.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "audit:job-icons": "tsx --env-file=.env.local scripts/audit-job-category-icons.ts",
    "eval:focus-presentation": "tsx scripts/evaluate-focus-presentation.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@ai-sdk/react": "^4.0.110",
    "@base-ui/react": "^1.8.0",
    "@lucide/lab": "^0.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@tiptap/core": ">=2.11.5 <4",
    "@tiptap/extension-placeholder": ">=2.11.5 <4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": ">=2.11.5 <4",
    "@tiptap/react": ">=2.11.5 <4",
    "@tiptap/starter-kit": ">=2.11.5 <4",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.107",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "country-state-city": "^3.2.1",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.0.0",
    "thinking-orbs": "^0.3.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unified": "^11.0.5"
  }
}
